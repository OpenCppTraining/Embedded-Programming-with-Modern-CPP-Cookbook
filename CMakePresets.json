{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "conf-common",
      "description": "Settings shared by every configure preset",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "conf-linux-common",
      "description": "Settings shared by every Linux preset",
      "hidden": true,
      "inherits": "conf-common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "conf-linux-gcc-common",
      "description": "Linux with GCC",
      "hidden": true,
      "inherits": "conf-linux-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "GCC Debug",
      "description": "Linux, GCC, Debug",
      "inherits": "conf-linux-gcc-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-dev",
      "displayName": "GCC Dev",
      "description": "Linux, GCC, RelWithDebInfo",
      "inherits": "conf-linux-gcc-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "GCC Release",
      "description": "Linux, GCC, Release",
      "inherits": "conf-linux-gcc-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "conf-linux-clang-common",
      "description": "Linux with Clang",
      "hidden": true,
      "inherits": "conf-linux-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Clang Debug",
      "description": "Linux, Clang, Debug",
      "inherits": "conf-linux-clang-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-dev",
      "displayName": "Clang Dev",
      "description": "Linux, Clang, RelWithDebInfo",
      "inherits": "conf-linux-clang-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Clang Release",
      "description": "Linux, Clang, Release",
      "inherits": "conf-linux-clang-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "conf-linux-arm-gnueabi-common",
      "description": "Linux, cross-compiling for ARM soft-float (arm-linux-gnueabi-g++)",
      "hidden": true,
      "inherits": "conf-linux-common",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-linux-gnueabi.cmake"
    },
    {
      "name": "linux-arm-gnueabi-debug",
      "displayName": "ARM soft-float Debug",
      "description": "Linux, ARM soft-float (arm-linux-gnueabi-g++), Debug",
      "inherits": "conf-linux-arm-gnueabi-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-arm-gnueabi-dev",
      "displayName": "ARM soft-float Dev",
      "description": "Linux, ARM soft-float (arm-linux-gnueabi-g++), RelWithDebInfo",
      "inherits": "conf-linux-arm-gnueabi-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-arm-gnueabi-release",
      "displayName": "ARM soft-float Release",
      "description": "Linux, ARM soft-float (arm-linux-gnueabi-g++), Release",
      "inherits": "conf-linux-arm-gnueabi-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "conf-linux-arm-gnueabihf-common",
      "description": "Linux, cross-compiling for ARM hard-float (arm-linux-gnueabihf-g++)",
      "hidden": true,
      "inherits": "conf-linux-common",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-linux-gnueabihf.cmake"
    },
    {
      "name": "linux-arm-gnueabihf-debug",
      "displayName": "ARM hard-float Debug",
      "description": "Linux, ARM hard-float (arm-linux-gnueabihf-g++), Debug",
      "inherits": "conf-linux-arm-gnueabihf-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-arm-gnueabihf-dev",
      "displayName": "ARM hard-float Dev",
      "description": "Linux, ARM hard-float (arm-linux-gnueabihf-g++), RelWithDebInfo",
      "inherits": "conf-linux-arm-gnueabihf-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-arm-gnueabihf-release",
      "displayName": "ARM hard-float Release",
      "description": "Linux, ARM hard-float (arm-linux-gnueabihf-g++), Release",
      "inherits": "conf-linux-arm-gnueabihf-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "conf-macos-common",
      "description": "Settings shared by every Darwin preset",
      "hidden": true,
      "inherits": "conf-common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "conf-macos-appleclang-common",
      "description": "Darwin with AppleClang",
      "hidden": true,
      "inherits": "conf-macos-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
      }
    },
    {
      "name": "macos-appleclang-debug",
      "displayName": "AppleClang Debug",
      "description": "Darwin, AppleClang, Debug",
      "inherits": "conf-macos-appleclang-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-appleclang-dev",
      "displayName": "AppleClang Dev",
      "description": "Darwin, AppleClang, RelWithDebInfo",
      "inherits": "conf-macos-appleclang-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-appleclang-release",
      "displayName": "AppleClang Release",
      "description": "Darwin, AppleClang, Release",
      "inherits": "conf-macos-appleclang-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
